{
  "name": "central-de-indicadores",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "security:check": "node scripts/check-no-secrets.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:upgrade:rdo": "prisma db execute --file prisma/manual/001_add_indicator_publications.sql --schema prisma/schema.prisma",
    "db:upgrade:accidents": "prisma db execute --file prisma/manual/004_accident_rate.sql --schema prisma/schema.prisma",
    "db:upgrade:idp-rso": "prisma db execute --file prisma/manual/005_idp_rso_versions.sql --schema prisma/schema.prisma",
    "db:upgrade:justifications": "prisma db execute --file prisma/manual/006_indicator_justifications.sql --schema prisma/schema.prisma",
    "db:upgrade:publication-cycle": "prisma db execute --file prisma/manual/007_indicator_publication_cycle.sql --schema prisma/schema.prisma",
    "db:upgrade:publication-cycle-year-fix": "prisma db execute --file prisma/manual/008_fix_publication_cycle_year_convention.sql --schema prisma/schema.prisma",
    "db:validate:publication-cycle-year-fix": "prisma db execute --file prisma/manual/009_validate_publication_cycle_constraint.sql --schema prisma/schema.prisma",
    "db:backfill:publication-cycle": "tsx scripts/backfill-publication-cycle.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "better-auth": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^4.5.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
